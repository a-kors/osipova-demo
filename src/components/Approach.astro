---
import { methods, methodsQuote } from '../data/master';
---

<section id="methods" class="approach">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">Музыкотерапия и&nbsp;другие методы</span>
      <h2>
        Через музыку и&nbsp;образы <em>легче</em> дойти до&nbsp;глубинного.
      </h2>
      <p>
        Вокал, фортепиано и&nbsp;развивающие занятия по&nbsp;музыке тоже
        методы музыкотерапии. А&nbsp;в&nbsp;работе психолога я использую
        и&nbsp;другие техники.
      </p>
    </header>

    <div class="principles">
      {methods.map((p, i) => (
        <article class="pr" data-reveal data-reveal-delay={Math.min(i * 100, 300)}>
          <span class="n">0{i + 1}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </article>
      ))}
    </div>

    <aside class="intensive" data-reveal>
      <div>
        <span class="section-eyebrow">Интенсив</span>
        <h3>«Свободный ребёнок: счастливый взрослый!»</h3>
        <p>
          Музыкотерапия в&nbsp;работе с&nbsp;Внутренним ребёнком. Знакомимся
          с&nbsp;ним, осуществляем связь и&nbsp;приобретаем внутреннюю опору.
          Подходит тем, кто боится, что у&nbsp;психолога будет больно, любит
          музыку и&nbsp;творчество, или кому легче говорить образами, чем словами.
        </p>
      </div>
      <dl>
        <div><dt>3</dt><dd>встречи по&nbsp;2‑2,5 часа</dd></div>
        <div><dt>4‑5</dt><dd>человек в&nbsp;группе</dd></div>
        <div><dt>чай</dt><dd>и&nbsp;все материалы включены</dd></div>
      </dl>
    </aside>

    <figure class="quote" data-reveal>
      <span class="mark" aria-hidden="true">“</span>
      <blockquote>{methodsQuote.text}</blockquote>
      <figcaption>{methodsQuote.source}</figcaption>
    </figure>
  </div>
</section>

<style>
  .approach {
    background: var(--bg-soft);
  }
  .section-head {
    max-width: 760px;
    margin-bottom: 48px;
  }
  .section-head h2 em {
    font-style: italic;
    color: var(--accent);
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 72px;
  }
  .pr {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 24px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .n {
    font-family: var(--font-serif);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .pr h3 {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0;
    font-weight: 400;
  }
  .pr p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .quote {
    margin: 0 auto;
    max-width: 920px;
    text-align: left;
    position: relative;
    padding-left: 48px;
  }
  .mark {
    position: absolute;
    left: -8px;
    top: -36px;
    font-family: var(--font-serif);
    font-size: 180px;
    color: var(--accent);
    line-height: 1;
    opacity: 0.15;
    user-select: none;
  }
  blockquote {
    margin: 0 0 24px;
    font-family: var(--font-serif);
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.4;
    color: var(--ink);
    letter-spacing: -0.015em;
  }
  figcaption {
    font-size: 14px;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    text-transform: uppercase;
  }

  @media (max-width: 1024px) {
    .principles {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .principles {
      grid-template-columns: 1fr;
    }
    .quote {
      padding-left: 28px;
    }
    .mark {
      left: -4px;
      top: -20px;
      font-size: 120px;
    }
  }
  .intensive {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    padding: clamp(28px, 4vw, 48px);
    background: #ffffff;
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-lg);
    margin: 0 0 72px;
  }
  .intensive h3 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.2;
    margin: 10px 0 14px;
    color: var(--ink);
  }
  .intensive p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 15.5px;
    line-height: 1.6;
  }
  .intensive dl {
    margin: 0;
    display: grid;
    gap: 18px;
  }
  .intensive dl div {
    display: flex;
    align-items: baseline;
    gap: 14px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 12px;
  }
  .intensive dt {
    font-family: var(--font-serif);
    font-size: 28px;
    color: var(--accent);
    min-width: 64px;
  }
  .intensive dd {
    margin: 0;
    font-size: 14.5px;
    color: var(--ink-muted);
  }
  @media (max-width: 860px) {
    .intensive { grid-template-columns: 1fr; }
  }
</style>
